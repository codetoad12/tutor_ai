# Staging Environment Variables
# Copy this file to .env.staging and update the values

# Django Environment
DJANGO_ENVIRONMENT=staging
DJANGO_SECRET_KEY=your-staging-secret-key-here
DEBUG=False

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=staging.yourdomain.com

# Database (Can use PostgreSQL or SQLite)
DATABASE_ENGINE=postgresql
DB_NAME=tutor_ai_staging
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432

# Redis (Optional for staging)
# REDIS_URL=redis://your-redis-host:6379/1

# CORS Settings (comma-separated)
CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com,http://localhost:3000

# API Keys
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Email Configuration (Can use console or SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=staging@yourdomain.com

# Logging
TOKEN_USAGE_LOG_LEVEL=INFO 