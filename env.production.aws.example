# Production Environment Variables for AWS Deployment
# Copy this file to .env.production and update the values

# Django Environment
DJANGO_ENVIRONMENT=production
DJANGO_SECRET_KEY=your-very-secure-secret-key-here
DEBUG=False

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-ec2-ip

# AWS Configuration
USE_AWS_SECRETS=true
AWS_REGION=us-east-1

# AWS Secrets Manager Secret Names
DB_SECRET_NAME=tutor-ai/database
API_KEYS_SECRET_NAME=tutor-ai/api-keys

# Fallback Database Configuration (if Secrets Manager fails)
# These will be ignored if USE_AWS_SECRETS=true and secrets are available
DB_NAME=tutor_ai_prod
DB_USER=your_db_user
DB_PASSWORD=fallback_password
DB_HOST=your_rds_endpoint
DB_PORT=5432

# Redis Configuration (Required for production)
# For AWS ElastiCache: redis://your-elasticache-endpoint:6379/0
# For EC2 Redis: redis://localhost:6379/0
REDIS_URL=redis://your-redis-host:6379/0

# CORS Settings (comma-separated)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Fallback API Keys (if Secrets Manager fails)
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Error Tracking (Optional)
SENTRY_DSN=your-sentry-dsn-here

# Logging
TOKEN_USAGE_LOG_LEVEL=INFO

# AWS IAM Role Configuration (for EC2 instances)
# If running on EC2 with IAM roles, these are not needed
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key 